# Copy this file to .env for local development, or set these as environment
# variables in your hosting provider's dashboard (e.g. GoDaddy Node.js Hosting
# > your app > Environment Variables). Never commit a real .env file.

# --- Contentful (read at build time, baked into the client bundle) ---
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=

# --- Contact form email (Resend) ---
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Contact form WhatsApp notification (optional, via CallMeBot) ---
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# Set automatically by GoDaddy Node.js Hosting at runtime — no need to set
# this yourself.
# PORT=3000
